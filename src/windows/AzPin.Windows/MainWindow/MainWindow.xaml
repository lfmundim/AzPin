<Window
    x:Class="AzPin.Windows.MainWindow.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:vm="using:AzPin.Windows.ViewModels"
    mc:Ignorable="d">
    <Grid>
        <tb:TaskbarIcon x:Name="TrayIcon"
                        NoLeftClickDelay="True" />
        <NavigationView
            x:Name="NavView"
            PaneDisplayMode="Left"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            OpenPaneLength="220"
            SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
            </NavigationView.MenuItems>

            <!-- Pinned RG sidebar -->
            <NavigationView.PaneCustomContent>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="PINNED"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="16,0,0,4" />
                    <ListView x:Name="PinnedRgList"
                              CanReorderItems="True"
                              CanDragItems="True"
                              AllowDrop="True"
                              SelectionMode="Single"
                              DragItemsCompleted="OnRgDragCompleted"
                              SelectionChanged="OnRgSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SidebarRgItemViewModel">
                                <Grid ColumnSpacing="8" Padding="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0"
                                              FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xED25;"
                                              FontSize="16"
                                              VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind DisplayName}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ContextFlyout>
                            <!-- per-item context menu set in code-behind -->
                        </ListView.ContextFlyout>
                    </ListView>
                    <TextBlock x:Name="NoPinnedRgsText"
                               Text="No pinned resource groups."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               Margin="16,4"
                               Visibility="Collapsed" />
                </StackPanel>
            </NavigationView.PaneCustomContent>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Icon="AllApps" Content="Resources" Tag="Browse" />
                <NavigationViewItem Icon="Setting" Content="Settings" Tag="Settings" />
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
