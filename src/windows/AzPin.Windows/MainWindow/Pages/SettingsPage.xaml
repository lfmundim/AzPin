<Page
    x:Class="AzPin.Windows.MainWindow.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AzPin.Windows.MainWindow.Pages"
    xmlns:vm="using:AzPin.Windows.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:InvertBoolToVisibilityConverter x:Key="NotBoolToVis" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tab bar -->
        <SelectorBar x:Name="TabBar"
                     HorizontalAlignment="Center"
                     Margin="0,12,0,8"
                     SelectionChanged="OnTabSelectionChanged">
            <SelectorBarItem x:Name="AccountTab"   Text="Account"       Tag="Account" />
            <SelectorBarItem x:Name="SubsTab"      Text="Subscriptions" Tag="Subscriptions" />
            <SelectorBarItem x:Name="PrefsTab"     Text="Preferences"   Tag="Preferences" />
        </SelectorBar>

        <!-- ── Account panel ── -->
        <Grid x:Name="AccountPanel" Grid.Row="1">
            <ScrollViewer Padding="24,8,24,24">
                <StackPanel Spacing="16">

                    <TextBlock Text="Identity" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,0">
                        <StackPanel>
                            <Grid Padding="0,12" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="User" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.Auth.AccountName, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid Padding="0,12" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tenant ID" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.Auth.TenantId, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontFamily="Consolas" FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Active Subscription" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,0">
                        <StackPanel>
                            <Grid Padding="0,12" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Name" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.Auth.ActiveSubscriptionName, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid Padding="0,12" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ID" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.Auth.ActiveSubscriptionId, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontFamily="Consolas" FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="8">
                        <Button Content="Refresh Token"
                                Command="{x:Bind ViewModel.Auth.RefreshCommand}" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── Subscriptions panel ── -->
        <Grid x:Name="SubscriptionsPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Padding="24,8,24,8">
                <StackPanel Spacing="0">
                    <ProgressRing IsActive="True" Width="32" Height="32"
                                  HorizontalAlignment="Center" Margin="0,24"
                                  Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,0"
                            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource NotBoolToVis}}">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Subscriptions, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:SubscriptionItemViewModel">
                                    <Grid Padding="0,10" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                                   VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1"
                                                      IsOn="{x:Bind IsVisible, Mode=TwoWay}"
                                                      OnContent="" OffContent=""
                                                      MinWidth="0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <TextBlock Grid.Row="1" Padding="24,0,24,16"
                       Text="Hidden subscriptions won't appear in Browse. Changes apply on the next load."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" />
        </Grid>

        <!-- ── Preferences panel ── -->
        <Grid x:Name="PreferencesPanel" Grid.Row="1" Visibility="Collapsed">
            <ScrollViewer Padding="24,8,24,24">
                <StackPanel Spacing="16">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,0">
                        <Grid Padding="0,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Open at Login" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{x:Bind ViewModel.OpenAtLogin, Mode=TwoWay}"
                                          OnContent="" OffContent=""
                                          MinWidth="0" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Updates" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,0">
                        <StackPanel>
                            <Grid Padding="0,12" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Current Version" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.CurrentVersion}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- idle / up-to-date: show Check button -->
                    <Button Content="Check for Updates"
                            Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                            Visibility="{x:Bind ViewModel.IsUpdateChecking, Mode=OneWay, Converter={StaticResource NotBoolToVis}}" />

                    <!-- checking: spinner -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind ViewModel.IsUpdateChecking, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <ProgressRing IsActive="True" Width="20" Height="20" />
                        <TextBlock Text="Checking for updates…" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- up to date -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,12"
                            Visibility="{x:Bind ViewModel.IsUpdateUpToDate, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock>
                            <Run Text="&#xE73E; " FontFamily="Segoe Fluent Icons" Foreground="Green" />
                            <Run Text="{x:Bind ViewModel.LatestVersion, Mode=OneWay}" />
                            <Run Text=" is the latest version." />
                        </TextBlock>
                    </Border>

                    <!-- update available -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,12"
                            Visibility="{x:Bind ViewModel.IsUpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="&#xE118; " FontFamily="Segoe Fluent Icons" />
                                <Run Text="v" /><Run Text="{x:Bind ViewModel.LatestVersion, Mode=OneWay}" />
                                <Run Text=" is available" />
                            </TextBlock>
                            <TextBlock Text="Run in a terminal to update:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="8,4">
                                <TextBlock Text="winget upgrade lfmundim.AzPin"
                                           FontFamily="Consolas" FontSize="12"
                                           IsTextSelectionEnabled="True" />
                            </Border>
                            <HyperlinkButton x:Name="ReleaseLink" NavigateUri="" Padding="0">
                                <TextBlock Text="View release on GitHub" />
                            </HyperlinkButton>
                        </StackPanel>
                    </Border>

                    <!-- failed -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,12"
                            Visibility="{x:Bind ViewModel.IsUpdateFailed, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="4">
                            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                                <Run Text="&#xEA39; " FontFamily="Segoe Fluent Icons" />
                                <Run Text="Update check failed" />
                            </TextBlock>
                            <TextBlock Text="{x:Bind ViewModel.UpdateErrorMessage, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Setup" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Button Content="Re-run Setup"
                            Command="{x:Bind ViewModel.ReRunSetupCommand}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</Page>
