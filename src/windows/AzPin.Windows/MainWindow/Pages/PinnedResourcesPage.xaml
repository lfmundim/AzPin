<Page
    x:Class="AzPin.Windows.MainWindow.Pages.PinnedResourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AzPin.Windows.MainWindow.Pages"
    xmlns:vm="using:AzPin.Windows.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:InvertBoolToVisibilityConverter x:Key="NotBoolToVis" />
    </Page.Resources>

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.Resources.Count, Mode=OneWay, Converter={StaticResource NotBoolToVis}}">
            <TextBlock Text="No pinned resources for this group."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ListView ItemsSource="{x:Bind ViewModel.Resources, Mode=OneWay}"
                  CanReorderItems="True"
                  CanDragItems="True"
                  AllowDrop="True"
                  DragItemsCompleted="OnDragCompleted"
                  SelectionMode="None"
                  Padding="8">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:PinnedResourceItemViewModel">
                    <Grid Padding="4,6" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind GlyphCode}"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="16"
                                   VerticalAlignment="Center" />

                        <HyperlinkButton Grid.Column="1"
                                         Content="{x:Bind Name}"
                                         NavigateUri="{x:Bind PortalUri}"
                                         Padding="0" VerticalAlignment="Center"
                                         HorizontalAlignment="Left" />

                        <Button Grid.Column="2"
                                CommandParameter="{x:Bind}"
                                Tag="{x:Bind}"
                                Click="OnUnpinClick"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Padding="4">
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE77A;"
                                      FontSize="14" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
